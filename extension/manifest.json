{
  "manifest_version": 3,
  "name": "FrameScribe 视频笔记",
  "version": "0.8.0",
  "description": "看视频时按一下就截图、记时间点、写一句；取字幕或本机转写，生成带时间的大纲，点一下跳回那一秒。B 站 · YouTube · Vimeo · 课程回放；网页里嵌入的 Vimeo / YouTube 可以按页批量出大纲。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.polyv.cn/*",
    "https://www.youtube.com/*",
    "https://vimeo.com/*",
    "https://player.vimeo.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FrameScribe：本页视频 / 笔记本",
    "default_popup": "popup.html"
  },
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "截图并记下时间点"
    },
    "capture-note": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "截图 + 写一句笔记"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "lib/md5.js",
        "lib/bili.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.polyv.cn/*",
        "https://www.youtube.com/*",
        "https://vimeo.com/*",
        "https://player.vimeo.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": [
        "page-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.polyv.cn/*",
        "https://www.youtube.com/*",
        "https://vimeo.com/*",
        "https://player.vimeo.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}

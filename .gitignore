host/logs/
# 桥接注册文件（install-host.ps1 按本机路径生成）
host/*.host.json
host/*-host.cmd
# 私人文档
docs/private/
# 系统 / 编辑器杂项
.DS_Store
Thumbs.db
desktop.ini
*.log
*.part
.vscode/
.idea/
# 隐私词私表
*.local.txt
